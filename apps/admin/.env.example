# ==============================================================================
# iNESTYL OUTLET — Private Admin Portal Environment Configuration (apps/admin)
# Domain: admin.inestyle.com
# PRIVATE SECRETS CONFIGURED ONLY ON SERVER & VERCEL PRODUCTION
# ==============================================================================

# Admin & Storefront Cross-Reference URLs
NEXT_PUBLIC_ADMIN_URL=https://admin.inestyle.com
NEXT_PUBLIC_STOREFRONT_URL=https://www.inestyle.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary Server Credentials (PRIVATE — NEVER EXPOSE IN CLIENT BUNDLES)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Session Cookie Encryption Secret
ADMIN_SESSION_SECRET=your_admin_session_secret_key_min_32_chars
