{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "iNESTYL OUTLET — Apple Minimal Design Tokens",
  "version": "2.0.0",
  "description": "A crisp, high-contrast premium system with generous whitespace, restrained color, and precise type hierarchy.",
  "brand": {
    "name": "iNESTYL OUTLET",
    "positioning": "Original Brands. Outlet Prices. Premium Experience.",
    "model": "Product catalogue, stock discovery index, and store enquiry portal (Strictly non-transactional)",
    "flagshipStore": "Kapadwanj, Gujarat, India"
  },
  "colors": {
    "primary": {
      "value": "#0071E3",
      "description": "Signature Apple blue used for primary actions, links, and key interactive emphasis"
    },
    "primaryStrong": {
      "value": "#0066CC",
      "description": "Deeper interaction state for links and buttons on hover/focus"
    },
    "secondary": {
      "value": "#2997FF",
      "description": "Lighter, luminous blue for outlined actions and secondary interactive emphasis"
    },
    "tertiary": {
      "value": "#1D1D1F",
      "description": "Core ink tone for text, headings, and dark UI surfaces"
    },
    "neutral": {
      "value": "#F5F5F7",
      "description": "Soft off-white background tone supporting spacious, airy canvas feel"
    },
    "surface": {
      "value": "#FFFFFF",
      "description": "Base card and canvas surface for clean product presentation"
    },
    "onSurface": {
      "value": "#1D1D1F",
      "description": "Default readable text color on light surfaces"
    },
    "muted": {
      "value": "#E5E7EB",
      "description": "Subtle divider and border color for low-contrast framing and card edges"
    },
    "backdrop": {
      "value": "#000000",
      "description": "Reserved for deepest dark navbar and saturated hero treatments"
    },
    "error": {
      "value": "#D92D20",
      "description": "Utility red for destructive states and alerts"
    },
    "semantic": {
      "stockIn": {
        "value": "#2E7D32",
        "description": "In stock badge text"
      },
      "stockInBg": {
        "value": "#E8F5E9",
        "description": "In stock badge background"
      },
      "stockLow": {
        "value": "#D97706",
        "description": "Low stock warning"
      },
      "whatsapp": {
        "value": "#25D366",
        "description": "WhatsApp Business enquiry green"
      }
    }
  },
  "typography": {
    "headlineDisplay": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "56px",
      "fontWeight": 700,
      "lineHeight": "67px",
      "letterSpacing": "0px"
    },
    "headlineLg": {
      "fontFamily": "SF Pro Display, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "47px",
      "fontWeight": 600,
      "lineHeight": "60px",
      "letterSpacing": "-0.28px"
    },
    "headlineMd": {
      "fontFamily": "SF Pro Display, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "40px",
      "fontWeight": 600,
      "lineHeight": "44px",
      "letterSpacing": "0px"
    },
    "headlineSm": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "33px",
      "fontWeight": 600,
      "lineHeight": "40px",
      "letterSpacing": "0px"
    },
    "bodyLg": {
      "fontFamily": "SF Pro Display, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "28px",
      "fontWeight": 400,
      "lineHeight": "42px",
      "letterSpacing": "0.196px"
    },
    "bodyMd": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "17px",
      "fontWeight": 400,
      "lineHeight": "26px",
      "letterSpacing": "0px"
    },
    "bodySm": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": "20px",
      "letterSpacing": "0px"
    },
    "labelLg": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "17px",
      "fontWeight": 400,
      "lineHeight": "26px",
      "letterSpacing": "0px"
    },
    "labelMd": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": "22px",
      "letterSpacing": "0px"
    },
    "labelSm": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "12px",
      "fontWeight": 500,
      "lineHeight": "16px",
      "letterSpacing": "0.02em"
    },
    "nav": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": "16px",
      "letterSpacing": "0em"
    },
    "eyebrow": {
      "fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, sans-serif",
      "fontSize": "12px",
      "fontWeight": 600,
      "lineHeight": "16px",
      "letterSpacing": "0.08em"
    }
  },
  "rounded": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "spacing": {
    "xs": "8px",
    "sm": "16px",
    "md": "24px",
    "lg": "54px",
    "xl": "70px",
    "gutter": "16px",
    "section": "54px"
  },
  "components": {
    "buttonPrimary": {
      "backgroundColor": "#0071E3",
      "textColor": "#FFFFFF",
      "hoverBackgroundColor": "#0066CC",
      "rounded": "9999px",
      "padding": "11px 21px",
      "height": "44px"
    },
    "buttonSecondary": {
      "backgroundColor": "transparent",
      "textColor": "#2997FF",
      "borderColor": "#2997FF",
      "hoverTextColor": "#0066CC",
      "rounded": "9999px",
      "padding": "11px 21px",
      "height": "44px"
    },
    "buttonTertiary": {
      "backgroundColor": "transparent",
      "textColor": "#0066CC",
      "rounded": "0px",
      "padding": "0px"
    },
    "card": {
      "backgroundColor": "#FFFFFF",
      "textColor": "#1D1D1F",
      "borderColor": "#E5E7EB",
      "rounded": "8px",
      "padding": "16px"
    },
    "input": {
      "backgroundColor": "#FFFFFF",
      "textColor": "#1D1D1F",
      "borderColor": "#E5E7EB",
      "rounded": "8px",
      "padding": "11px 16px"
    },
    "navItem": {
      "backgroundColor": "transparent",
      "textColor": "#1D1D1F",
      "fontSize": "12px",
      "padding": "0px"
    }
  }
}
