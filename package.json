{
  "name": "inestyle-outlet-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "iNESTYL OUTLET — Decoupled Monorepo for Public Storefront and Private Admin Portal",
  "scripts": {
    "dev:storefront": "pnpm --filter @inestyle/storefront dev",
    "dev:admin": "pnpm --filter @inestyle/admin dev",
    "build:storefront": "pnpm --filter @inestyle/storefront build",
    "build:admin": "pnpm --filter @inestyle/admin build",
    "build:packages": "pnpm --filter \"@inestyle/*\" typecheck",
    "build": "pnpm --filter @inestyle/storefront build && pnpm --filter @inestyle/admin build",
    "typecheck": "pnpm -r run typecheck",
    "test:security": "node scripts/test-security-suite.js",
    "seed:db": "node scripts/generate-supabase-seed.js"
  },
  "dependencies": {
    "@inestyle/database": "workspace:*",
    "@inestyle/permissions": "workspace:*",
    "@inestyle/shared-types": "workspace:*",
    "@inestyle/shared-utils": "workspace:*",
    "@inestyle/validations": "workspace:*",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.119.0",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
