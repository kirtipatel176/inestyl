# ==============================================================================
# iNESTYL OUTLET — Public Storefront Environment Configuration (apps/storefront)
# Domain: www.inestyle.com
# STRICT REQUIREMENT: Only public configuration. Zero administrative keys!
# ==============================================================================

# Storefront Public Application URL
NEXT_PUBLIC_APP_URL=https://www.inestyle.com

# Supabase Public Anonymous Configuration (Constrained by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudinary Public Client Delivery (Browser asset rendering)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# WhatsApp Store Concierge & Kapadwanj Flagship Parameters
NEXT_PUBLIC_WHATSAPP_PHONE=919876543210
NEXT_PUBLIC_STORE_LOCATION="Station Road, Kapadwanj, Gujarat 387620"
NEXT_PUBLIC_STORE_HOURS="Mon - Sun: 10:00 AM - 9:00 PM"
