# ==============================================================================
# iNESTYL OUTLET — Decoupled Monorepo Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STOREFRONT APPLICATION (apps/storefront)
# ------------------------------------------------------------------------------
# Storefront public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Store Concierge & Kapadwanj Flagship Parameters
NEXT_PUBLIC_WHATSAPP_PHONE=919876543210
NEXT_PUBLIC_STORE_LOCATION="Station Road, Kapadwanj, Gujarat 387620"
NEXT_PUBLIC_STORE_HOURS="Mon - Sun: 10:00 AM - 9:00 PM"

# Cloudinary Public Client Delivery (Safe for browser bundle)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ------------------------------------------------------------------------------
# 2. ADMIN APPLICATION (apps/admin)
# ------------------------------------------------------------------------------
# Admin portal URL & Storefront cross-reference
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. SHARED DURABLE DATABASE & BACKEND
# ------------------------------------------------------------------------------
# Optional PostgreSQL / Supabase connection strings
# If omitted, @inestyle/database uses durable atomic file persistence with auto-sync
# DATABASE_URL=postgresql://postgres:password@localhost:5432/inestyle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional custom database path override
# INESTYLE_DB_PATH=/var/data/inestyle/db.json
# INESTYLE_AUTH_DB_PATH=/var/data/inestyle/admin-auth.json

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
