{
  "name": "inestyle-outlet-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "iNESTYL OUTLET — Decoupled Monorepo for Public Storefront and Private Admin Portal",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:storefront": "pnpm --filter @inestyle/storefront dev",
    "dev:admin": "pnpm --filter @inestyle/admin dev",
    "build:storefront": "pnpm --filter @inestyle/storefront build",
    "build:admin": "pnpm --filter @inestyle/admin build",
    "build:packages": "pnpm --filter \"@inestyle/*\" typecheck",
    "build": "pnpm --filter @inestyle/storefront build && pnpm --filter @inestyle/admin build",
    "typecheck": "pnpm -r run typecheck",
    "test:security": "node scripts/test-security-suite.js",
    "seed:db": "node scripts/generate-supabase-seed.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
